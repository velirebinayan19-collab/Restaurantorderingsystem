{% extends 'base.html' %}
{% block content %}
<div class="container mt-4">
    <h2>Process Payment for Order #{{ order.id }}</h2>
    <hr>
    
    <div class="card p-4 shadow-sm bg-light" style="max-width: 500px;">
        <form action="{{ url_for('order.process_payment', order_id=order.id) }}" method="POST">
            
            <!-- Amount Due -->
            <div class="mb-3">
                <label class="form-label fw-bold">Amount Due:</label>
                <input type="text" class="form-control fw-bold text-success fs-5" value="₱{{ '%.2f'|format(order.total_amount) }}" readonly>
            </div>
            
            <!-- Payment Method Selection -->
            <div class="mb-3">
                <label for="payment_method" class="form-label fw-bold">Payment Method:</label>
                <select name="payment_method" id="payment_method" class="form-select" required>
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Bank/Electronic">Bank / Electronic Payment</option>
                </select>
            </div>
            
            <!-- Amount Paid Input -->
            <div class="mb-3">
                <label for="amount_paid" class="form-label fw-bold">Amount Paid (₱):</label>
                <input type="number" step="0.01" name="amount_paid" id="amount_paid" class="form-control" placeholder="e.g., 500.00" required>
            </div>
            
            <!-- Submit Button -->
            <button type="submit" class="btn btn-success btn-lg w-100">Confirm Payment & Complete</button>
        </form>
    </div>
    
    <div class="mt-3">
        <a href="{{ url_for('order.track_orders') }}" class="btn btn-secondary">Back to Order Tracker</a>
    </div>
</div>
{% endblock %}