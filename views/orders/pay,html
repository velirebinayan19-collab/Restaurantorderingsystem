<!-- Add data-total to your form tag -->
<form method="POST" action="{{ url_for('order.process_payment', order_id=order.id) }}" id="paymentForm" data-total="{{ order.total_amount }}">
    
    <div class="mb-3">
        <label class="form-label font-weight-bold">Amount Due:</label>
        <input type="text" class="form-control" value="₱{{ '%.2f'|format(order.total_amount) }}" readonly>
    </div>

    <div class="mb-3">
        <label class="form-label font-weight-bold">Payment Method:</label>
        <select name="payment_method" class="form-select" id="paymentMethodSelect" onchange="toggleAmountPaid()">
            <option value="Cash">Cash</option>
            <option value="Card">Card</option>
            <option value="Bank / Electronic Payment">Bank / Electronic Payment</option>
        </select>
    </div>

    <div class="mb-3" id="amountPaidContainer">
        <label class="form-label font-weight-bold">Amount Paid (Cash):</label>
        <input type="number" step="0.01" name="amount_paid" id="amountPaidInput" class="form-control" placeholder="Enter cash given by customer">
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a href="{{ url_for('order.track_orders') }}" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-success">Confirm Payment & Print Receipt</button>
    </div>

</form>

<!-- Clean JavaScript reading from the form's data attribute -->
<script>
function toggleAmountPaid() {
    const form = document.getElementById('paymentForm');
    const methodSelect = document.getElementById('paymentMethodSelect');
    const amountPaidContainer = document.getElementById('amountPaidContainer');
    const amountPaidInput = document.getElementById('amountPaidInput');
    const totalAmount = parseFloat(form.dataset.total);

    if (methodSelect.value === 'Cash') {
        amountPaidContainer.style.display = 'block';
        amountPaidInput.required = true;
        amountPaidInput.value = ''; // Let user type cash
    } else {
        amountPaidContainer.style.display = 'none';
        amountPaidInput.required = false;
        amountPaidInput.value = totalAmount; // Auto-fill exact amount for card/bank
    }
}

document.addEventListener('DOMContentLoaded', toggleAmountPaid);
</script>